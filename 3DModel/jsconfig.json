{
    "compilerOptions": {
        "baseUrl": "src",
        "paths": {
            "@contexts/*": [
                "contexts/*"
            ],
            "@components/*": [
                "components/*"
            ],
            "@common/*": [
                "components/common/*"
            ],
            "@variables/*": [
                "assets/variables/*"
            ],
            "@services/*": [
                "services/*"
            ]
        }
    },
    "include": [
        "src/**/*"
    ]
}